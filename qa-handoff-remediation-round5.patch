+import { db } from "@/db";
+import {
+  users,
+  profiles,
+  artworks,
+  artworkVersions,
+  portfolioEntries,
+  challenges,
+  challengeSubmissions,
+  challengeVotingRounds,
+  challengeVotingRoundCandidates,
+  challengeResults,
+} from "@/db/schema";
