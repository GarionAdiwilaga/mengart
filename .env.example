# Application Environment
NODE_ENV=development
APP_URL=http://localhost:3000
TIMEZONE=Asia/Makassar

# PostgreSQL Database
POSTGRES_USER=mengart
POSTGRES_PASSWORD=mengart_dev_pass
POSTGRES_DB=mengart_db
POSTGRES_PORT=5433
DATABASE_URL=postgres://mengart:mengart_dev_pass@localhost:5433/mengart_db

# Redis & Queue
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication (NextAuth / Auth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=mengart_super_secret_session_key_32bytes_dev_only
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Storage Configuration (Private master and Public watermarked derivatives)
STORAGE_ROOT=./storage
