diff --git a/src/components/auth/SignOutButton.tsx b/src/components/auth/SignOutButton.tsx
new file mode 100644
index 0000000..efa48bb
--- /dev/null
+++ b/src/components/auth/SignOutButton.tsx
@@ -0,0 +1,31 @@
+"use client";
+
+import { clearAllSubmissionDrafts } from "@/lib/utils/draftStorage";
+import { logoutAction } from "@/app/actions/auth";
+import { ReactNode } from "react";
+
+interface SignOutButtonProps {
+  className?: string;
+  children: ReactNode;
+}
+
+export function SignOutButton({ className, children }: SignOutButtonProps) {
+  const handleLogout = async () => {
+    clearAllSubmissionDrafts();
+    await logoutAction();
+  };
+
+  return (
+    <form action={handleLogout} className="w-full">
+      <button
+        type="submit"
+        className={className}
+        onClick={() => {
+          clearAllSubmissionDrafts();
+        }}
+      >
+        {children}
+      </button>
+    </form>
+  );
+}
