+      {...props}
+    >
+      {showIcon && <Clock className="h-3 w-3 text-zinc-500 shrink-0" />}
+      {prefix && <span className="text-zinc-500 font-sans">{prefix}</span>}
+      <span>{formatted}</span>
+    </span>
+  );
+}
